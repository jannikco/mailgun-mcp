{
  "id": "mailgun",
  "name": "Mailgun",
  "version": "0.1.0",
  "baseUrl": "https://api.mailgun.net",
  "auth": {
    "type": "basic",
    "usernameEnv": "MAILGUN_BASIC_USERNAME",
    "passwordEnv": "MAILGUN_API_KEY"
  },
  "tools": [
    {
      "name": "mailgun_list_domains",
      "description": "Read one page of US-region sending domains.",
      "method": "GET",
      "path": "/v4/domains",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "skip": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {
          "limit": "limit",
          "skip": "skip"
        },
        "body": {}
      },
      "sampleArguments": {
        "limit": 10
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://documentation.mailgun.com/docs/mailgun/api-reference/send/mailgun/domains"
      ]
    },
    {
      "name": "mailgun_get_domain",
      "description": "Read sending-domain details; this is not a message delivery test.",
      "method": "GET",
      "path": "/v4/domains/{domain}",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "domain"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "domain"
        ],
        "query": {},
        "body": {}
      },
      "sampleArguments": {
        "domain": "sandbox.example.com"
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://documentation.mailgun.com/docs/mailgun/api-reference/send/mailgun/domains"
      ]
    }
  ],
  "workflow": {
    "name": "Mailgun authorized workflow",
    "description": "Inspect configured sending domains and their verification details without sending messages.",
    "steps": [
      "mailgun_list_domains",
      "mailgun_get_domain"
    ]
  },
